+/**
+ * @ingroup system-tests-tc
+ *
+ * Build an IPv4 + TCP data-bearing ACK (the ACK flag set, but with @p
+ * payloadBytes of segment data after the TCP header). Linux cake_ack_filter
+ * accepts such a packet as a filtering TRIGGER (it only checks the ACK/SYN
+ * flags on the triggering packet); the pure-ACK / option-walk checks apply to
+ * the queued drop candidates, not the trigger.
+ */
+static Ptr<Ipv4QueueDiscItem>
+MakeDataAckItem(Ipv4Address src,
+                Ipv4Address dst,
+                uint16_t srcPort,
+                uint16_t dstPort,
+                uint32_t ackNum,
+                uint32_t payloadBytes)
+{
+    TcpHeader tcp;
+    tcp.SetSourcePort(srcPort);
+    tcp.SetDestinationPort(dstPort);
+    tcp.SetAckNumber(SequenceNumber32(ackNum));
+    tcp.SetSequenceNumber(SequenceNumber32(1));
+    tcp.SetFlags(TcpHeader::ACK);
+    tcp.SetWindowSize(65535);
+
+    Ptr<Packet> p = Create<Packet>(payloadBytes);
+    p->AddHeader(tcp);
+
+    Ipv4Header ip;
+    ip.SetSource(src);
+    ip.SetDestination(dst);
+    ip.SetProtocol(6);
+    ip.SetPayloadSize(p->GetSize());
+    return Create<Ipv4QueueDiscItem>(p, Address(), 0x0800, ip);
+}
