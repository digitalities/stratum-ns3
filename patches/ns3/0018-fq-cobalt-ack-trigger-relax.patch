+/**
+ * @ingroup system-tests-tc
+ *
+ * A data-bearing ACK (ACK flag set, segment data after the TCP header) must be
+ * accepted as a filtering TRIGGER and drop an older redundant pure ACK in the
+ * same flow. Linux cake_ack_filter gates the triggering packet on the ACK/SYN
+ * flags only; the pure-ACK / option-walk checks apply to the queued drop
+ * candidates, not the trigger. Over-constraining the trigger to pure ACKs lets
+ * piggybacked (data + ACK) packets fail to filter redundant ACKs.
+ */
+class FqCobaltQueueDiscAckFilterDataBearingTrigger : public TestCase
+{
+  public:
+    FqCobaltQueueDiscAckFilterDataBearingTrigger()
+        : TestCase("FqCobalt ACK filter: a data-bearing ACK is a valid trigger")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        const Ipv4Address srcA("10.1.1.1");
+        const Ipv4Address dstA("10.2.2.2");
+        constexpr uint16_t kSport = 1024;
+        constexpr uint16_t kDport = 80;
+
+        // Roomy queue so the trigger is not Cobalt-rejected.
+        Ptr<FqCobaltQueueDisc> q = CreateObjectWithAttributes<FqCobaltQueueDisc>(
+            "EnableAckFilter",
+            BooleanValue(true),
+            "EnableAckFilterAggressive",
+            BooleanValue(true),
+            "MaxSize",
+            QueueSizeValue(QueueSize("8p")));
+        q->SetQuantum(1514);
+        q->Initialize();
+
+        // Two redundant pure ACKs (cumulative 10), then a data-bearing ACK with
+        // a higher cumulative number. The data-bearing ACK must trigger the
+        // filter and drop a redundant older pure ACK.
+        q->Enqueue(MakeAckOnlyItem(srcA, dstA, kSport, kDport, 10));
+        q->Enqueue(MakeAckOnlyItem(srcA, dstA, kSport, kDport, 10));
+        q->Enqueue(MakeDataAckItem(srcA, dstA, kSport, kDport, 20, /*payloadBytes=*/200));
+
+        NS_TEST_ASSERT_MSG_GT(q->GetAckFilterDrops(),
+                              0u,
+                              "A data-bearing ACK must trigger the ACK filter (Linux gates the "
+                              "trigger on flags only); got 0 drops, so the trigger was wrongly "
+                              "rejected for carrying segment data.");
+        Simulator::Destroy();
+    }
+};
